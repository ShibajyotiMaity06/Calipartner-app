{
  "name": "calipartner",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "app",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint . && node scripts/lint_tokens.mjs",
    "lint:tokens": "node scripts/lint_tokens.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:db && npm run test:billing",
    "test:db": "node scripts/test_rooms_v3.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "app": "npm run start --workspace app",
    "app:web": "npm run web --workspace app",
    "build:web": "npm run build:web --workspace app",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:serve": "supabase functions serve --no-verify-jwt",
    "food:seed": "npx tsx scripts/food_tools.ts",
    "recipes:import": "npx tsx scripts/recipes_import.ts",
    "test:billing": "npx --yes deno@2.9.6 test --allow-env --config supabase/functions/dodo-checkout/deno.json supabase/functions/_shared/dodoHandlers.test.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^9.0.0",
    "@types/deno": "^2.7.0",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "pg": "^8.23.1",
    "prettier": "^3.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "supabase": "^2.120.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0"
  }
}
