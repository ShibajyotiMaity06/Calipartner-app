EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Local anon key: run `npx supabase status` and copy "anon key". Never put service-role keys here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_ENV=development
# RevenueCat public API keys (Apple & Google Play)
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=

# Optional public native integration identifiers. Restrict the Maps key to the Android package and signing certificate.
EXPO_PUBLIC_APPLE_APP_ID=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
