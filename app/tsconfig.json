{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "lib": ["ESNext"],
    "types": ["react-native"],
    "noEmit": true,
    "allowJs": false,
    "paths": {
      "@/*": ["./src/*"],
      "@calipartner/ui": ["../packages/ui/src/index.ts"],
      "@calipartner/ui/*": ["../packages/ui/src/*"],
      "packages/ui/tokens": ["../packages/ui/src/tokens/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
