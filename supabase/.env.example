# Supabase Secrets & Configuration Example
# Set these in your Supabase Project Settings -> Edge Functions -> Secrets
# or local supabase/.env / supabase/functions/.env

# Supabase Local / Remote
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Configuration (PRD Phase 11 & Coach / Dietitian)
# 1. AI Dietitian / Coach (Text-to-Text: OpenRouter deepseek/deepseek-v4-flash:free)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free

# 2. AI Vision / Food Photo Scanning (Gemini for testing, Claude for production)
VISION_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-haiku-5-5

# RevenueCat Webhook Secret
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret
# Enable only on an isolated testing backend. Production ignores sandbox events.
REVENUECAT_ALLOW_SANDBOX=false

# Storage (Cloudflare R2 private bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_CHAT_BUCKET=calipartner-chat-private

# Firebase Cloud Messaging for Push
FIREBASE_SERVICE_ACCOUNT=
# Server-only scoped token shared by the worker and its Vault-backed cron job.
PUSH_WORKER_SECRET=

# Browser payments. Never put any Dodo API/webhook keys in app EXPO_PUBLIC_* config.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_ENVIRONMENT=live_mode
DODO_ALLOW_TEST_MODE=false
DODO_APP_URL=https://your-app.example
# Four recurring Dodo products; values are product IDs from your Dodo dashboard.
DODO_PRODUCTS_JSON={"plus_monthly":"pdt_replace","plus_annual":"pdt_replace","pro_monthly":"pdt_replace","pro_annual":"pdt_replace"}
# Optional separate international USD registry. Accounts with a stored non-IN country use it.
DODO_PRODUCTS_USD_JSON={"plus_monthly":"pdt_replace_usd","plus_annual":"pdt_replace_usd","pro_monthly":"pdt_replace_usd","pro_annual":"pdt_replace_usd"}

# India-only web subscriptions. Native Android/iOS remain RevenueCat store purchases.
# Keep all values in Supabase Edge Function secrets; never use app EXPO_PUBLIC_* variables.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENVIRONMENT=live
RAZORPAY_ALLOW_TEST_MODE=false
# Optional when the existing DODO_APP_URL already names the same production web origin.
RAZORPAY_APP_URL=https://your-app.example
RAZORPAY_PLANS_JSON={"plus_monthly":"plan_replace1","plus_annual":"plan_replace2","pro_monthly":"plan_replace3","pro_annual":"plan_replace4"}
