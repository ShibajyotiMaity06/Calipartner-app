# Supabase Secrets & Configuration Example
# Set these in your Supabase Project Settings -> Edge Functions -> Secrets
# or local supabase/.env / supabase/functions/.env

# Supabase Local / Remote
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Configuration (PRD Phase 11 & Coach / Dietitian)
# 1. AI Dietitian / Coach (Text-to-Text: OpenRouter deepseek/deepseek-v4-flash:free)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free

# 2. AI Vision / Food Photo Scanning (Gemini for testing, Claude for production)
VISION_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-haiku-20241022

# RevenueCat Webhook Secret
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret

# Storage (Cloudflare R2 private bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_CHAT_BUCKET=calipartner-chat-private

# Firebase Cloud Messaging for Push
FIREBASE_SERVICE_ACCOUNT=
