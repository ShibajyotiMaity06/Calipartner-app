{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "typeRoots": ["../../node_modules/@types"],
    "types": ["deno", "node"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "jsr:@supabase/supabase-js@*": ["../../node_modules/@supabase/supabase-js"],
      "jsr:@supabase/supabase-js": ["../../node_modules/@supabase/supabase-js"],
      "npm:@supabase/supabase-js@*": ["../../node_modules/@supabase/supabase-js"],
      "npm:@supabase/supabase-js": ["../../node_modules/@supabase/supabase-js"],
      "@calipartner/core": ["../../packages/core/src/index.ts"],
      "@feed-tracking": ["../../packages/core/src/personalTracking.ts"],
      "npm:*": ["../../node_modules/*"]
    }
  },
  "include": ["./**/*.ts", "./*.d.ts"]
}
